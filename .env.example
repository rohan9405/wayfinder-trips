# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=

# Optional: override the model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: OpenUI's anonymous usage telemetry is on by default; this turns it off.
OPENUI_TELEMETRY_DISABLED=1

# Optional free-tier fallbacks, tried after Gemini (only free tiers are ever used):
# GROQ_API_KEY=            # https://console.groq.com/keys (free plan: 8K tokens/min per model)
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys (only ":free" models)
# CLOUDFLARE_ACCOUNT_ID=   # Workers AI on the Workers Free plan: 10K neurons/day
# CLOUDFLARE_API_TOKEN=    # token with Workers AI (and D1, for the store) permission
# D1_DATABASE_ID=          # Cloudflare D1 database for cache, logs, model health, usage
# ADMIN_TOKEN=             # protects /api/admin/llm (npm run llm:report)
# ADMIN_PASSWORD=          # password for the sidebar admin sign-in
# SESSION_SECRET=          # random 32+ character secret for signed guest/admin cookies
# NVIDIA_API_KEY=          # https://build.nvidia.com (free developer access)
# Pin models instead of the defaults: GROQ_MODELS, OPENROUTER_MODELS, CLOUDFLARE_MODELS, NVIDIA_MODELS

# Optional: how often the answer cache refreshes, in hours (default 24, aligned to UTC midnight)
# CACHE_REFRESH_HOURS=24
# Optional: daily AI answer budget shown by the sidebar counter (estimate; default 150)
# DAILY_ANSWER_BUDGET=150

# Local development only: pretend the visitor is at "lat,lon" (Vercel sends real geo headers).
# DEV_GEO=28.67,77.44
